# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Phase 0: these are read by app/ai/config.py but only the stub provider exists,
# so no real key is needed yet. A real key is required starting Phase 1.
# Default runtime provider is OpenRouter (OpenAI-compatible, has free models).
# Any OpenAI-compatible endpoint works — just change these four values by
# editing this file. (The Settings page shows the masked key read-only; key
# rotation stays a file edit on purpose — only cadence + pause default are
# editable there.)
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=cohere/north-mini-code:free
AI_API_KEY=your-key-here
# Optional: override where the SQLite file lives (default: data/university.db).
DATA_DIR=data
# Phase 6: how many days between Roommate (cross-domain) prompts per active
# course. "A couple of times a week" is the default (3). Min 1. Editable and
# written back to this file from the Settings page.
ROOMMATE_CADENCE_DAYS=3
# Phase 7 completion: default status for newly confirmed Courses. When "true",
# the Advisor starts them as paused and you unpause them when ready. Editable
# on the Settings page (written back to this file).
NEW_COURSES_START_PAUSED=false
